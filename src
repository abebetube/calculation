<!DOCTYPE html>
<html lang="he">
<head>
    <meta charset="UTF-8" />
    <title>מחשבון משכנתא</title>
</head>
<body>

<h2>מחשבון היתכנות למשכנתא</h2>

<form id="mortgageForm">
  <label>הכנסה חודשית נטו (₪):</label>
  <input type="number" id="income" required />

  <label>התחייבויות חודשיות קיימות (₪):</label>
  <input type="number" id="expenses" required />

  <label>אחוז כושר החזר מותר (עד 40%):</label>
  <input type="number" id="maxReturnPercent" value="35" min="10" max="40" required />

  <label>הון עצמי (₪):</label>
  <input type="number" id="ownCapital" oninput="updateLoanAmount()" required />

  <label>עלות הדירה (₪):</label>
  <input type="number" id="propertyPrice" oninput="updateLoanAmount()" required />

  <label>סכום משכנתא מבוקש (₪):</label>
  <input type="number" id="loanAmount" readonly />

  <label>ריבית שנתית (%):</label>
  <input type="number" id="interestRate" step="0.01" required />

  <label>תקופת ההלוואה (שנים):</label>
  <input type="number" id="years" required />

  <label>מספר לווים:</label>
  <select id="guarantorCount">
    <option value="1" selected>לווה אחד</option>
    <option value="2">שני לווים</option>
  </select>

   <h4>פרטי הלווה הראשון</h4>
  <label>לווה 1 - מין:</label>
  <select id="gender1">
    <option value="male">זכר</option>
    <option value="female">נקבה</option>
  </select>

  <label>לווה 1 - גיל:</label>
  <input type="number" id="age1" min="18" max="100" required />

  <div id="secondGuarantorFields" style="display: none; margin-top: 10px;">
    <h4>פרטי הלווה השני</h4>
    <label>לווה 2 - מין:</label>
    <select id="gender2">
      <option value="male">זכר</option>
      <option value="female">נקבה</option>
    </select>

    <label>לווה 2 - גיל:</label>
    <input type="number" id="age2" min="18" max="100" />
  </div>

 

  <br/><br/>

  <button type="button" id="calculateBtn">חשב</button>
  <button type="button" id="saveBtn">שמור תוצאה</button>
  <button type="button" id="exportBtn">יצא תוצאה</button>
  <button type="button" id="saveCalculationBtn">שמור נתונים</button>
  <button type="button" id="loadCalculationBtn">טען נתונים </button>
</form>

<div class="result" id="result"></div>

<!-- קישורי ספריות חיצוניות -->
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<!-- כאן יוכנס הקוד ב-JS -->
<script src="script.js"></script>

</body>
</html>
